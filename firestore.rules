rules_version = '2';

// ─── togethertr / T-CID Firestore Security Rules ────────────────────────────
//
// 멤버십 모델:
//   projects/{pid}.memberUids: string[]  (Firestore 내부 데이터 모델)
//   - 09.Firebase데이터모델.md spec의 members 서브컬렉션이 아니라 배열로 구현됨.
//   - rules는 이 배열 기준으로 멤버십을 판정한다.
//
// 비용 노트 (서브컬렉션 접근 시):
//   - 모든 서브컬렉션 rule(`messages`, `materials`, `artifacts`, `lobby`, ...)은
//     `isMember(pid)` 헬퍼를 호출하며, 이는 매 평가마다 `projects/{pid}` 문서를
//     1회 read 한다. Firestore rules engine은 같은 요청 안에서 동일 get()을
//     캐시하지만, 단일 rule 평가당 get() 호출 한도는 10이다.
//   - 즉 서브컬렉션 1건 read = 프로젝트 문서 1 read 추가 비용.
//   - 대용량 batch는 가능하면 같은 요청으로 묶을 것.
//
// 미해결 trade-off (01-data-structure.md P0-1 보고 참조):
//   1) inviteCode 가진 프로젝트는 인증된 사용자 누구나 get 가능 — join 페이지
//      미리보기를 위함. P1에서 별도 inviteCodes/{code} 인덱스 컬렉션으로 이전 예정.
//   2) self-join 시 rules는 inviteCode 일치 여부를 검증할 수 없음. 앱 레벨에서
//      findProjectByInviteCode → joinProject 순서로 검증하지만, 클라이언트가
//      이를 우회하고 projectId만으로 joinProject를 호출하면 차단 불가.
//      완전 차단은 Cloud Function 위임 필요(범위 외).
// ────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── helpers ──────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isProjectMemberData(data) {
      return isSignedIn()
        && (
          (data.memberUids is list && data.memberUids.hasAny([request.auth.uid]))
          || data.createdBy == request.auth.uid
          || data.hostUid == request.auth.uid
        );
    }

    // 서브컬렉션용: 부모 프로젝트 문서를 읽어 멤버십 확인
    function isMember(pid) {
      return isProjectMemberData(get(/databases/$(database)/documents/projects/$(pid)).data);
    }

    // projects/{pid} 자체에 대한 rule에서 사용 — resource를 넘겨 get() 절약
    function isMemberOf(res) {
      return isProjectMemberData(res.data);
    }

    function isHostOf(res) {
      return isSignedIn()
        && (
          res.data.hostUid == request.auth.uid
          || res.data.createdBy == request.auth.uid
        );
    }

    // 팀원은 공동 워크스페이스·프로필 등은 갱신할 수 있지만, 산출물 확정과
    // 활동/단계/주기 전환처럼 전체 팀 흐름을 바꾸는 필드는 호스트만 수정한다.
    function isMemberSafeProjectUpdate() {
      return isMemberOf(resource)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['teamGradeBands', 'targetGradeGroup'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['teamGradeBandProposals'])
          || request.resource.data.get('teamGradeBandProposals', {}).diff(resource.data.get('teamGradeBandProposals', {}))
               .affectedKeys().hasOnly([request.auth.uid]))
        && !request.resource.data.diff(resource.data).changedKeys().hasAny([
          'artifacts',
          'activityStatuses',
          'currentActivity',
          'currentStage',
          'currentCycle',
          'cycleCount',
          'isECompleted',
          'isA23Completed',
          'previousCycleImprovements',
          'cycleStartT11Version',
          'stageReports',
          'cumulativeReport',
          'hostUid',
          'createdBy',
          'memberUids',
          'inviteCode',
          'started'
        ]);
    }

    // self-join 전용 update: 본인 uid를 memberUids에 추가하고 memberInfo 등록만 허용
    function isSelfJoinUpdate() {
      return isSignedIn()
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['memberUids', 'memberInfo', 'updatedAt'])
        && (!(resource.data.memberUids is list)
             || request.resource.data.memberUids.hasAll(resource.data.memberUids))
        && request.resource.data.memberUids.hasAll([request.auth.uid]);
    }

    // ─── users ────────────────────────────────────────────────────────────
    // 프로필 카드(displayName/color/emoji)는 같은 프로젝트 멤버가 표시하므로
    // 인증된 사용자에 한해 read 허용. write/delete는 본인만.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // ─── projects ────────────────────────────────────────────────────────
    match /projects/{pid} {

      // get: 멤버, 또는 createdBy(레거시), 또는 inviteCode를 가진 프로젝트(미리보기)
      allow get: if isSignedIn()
        && (
          isMemberOf(resource)
          || resource.data.createdBy == request.auth.uid
          || resource.data.inviteCode != null
        );

      // list/query: 인증된 사용자에게 제한된 limit 으로만 허용.
      // (Firebase rules는 request.query.where 를 노출하지 않으므로 where 절 검증은 불가.
      //  따라서 클라이언트 side에서 적절한 where 를 항상 사용해야 한다 — 코드 컨벤션으로 강제.)
      //
      // TODO(P1, security): 악의적 클라이언트가 다른 사용자의 uid 로 array-contains
      //   query 를 보내면 그 사용자의 프로젝트 메타데이터(title/inviteCode 등)가 노출될 수
      //   있다. 콘텐츠(messages/artifacts) 는 멤버십 보호로 안전하지만 메타데이터 누설은 막지
      //   못한다. 해결책: 별도 인덱스 컬렉션 user_projects/{uid}/{pid} 도입 → 그쪽만 list 허용
      //   하고 projects 컬렉션은 get-only 로 잠금. 본인 컬렉션만 list 가능 → where 검증 불필요.
      allow list: if isSignedIn() && request.query.limit <= 50;

      // create: 본인이 createdBy + memberUids에 본인 포함
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberUids.hasAll([request.auth.uid]);

      // update: 호스트는 전체 필드, 팀원은 협업용 비제어 필드, 비멤버는 self-join만
      allow update: if isHostOf(resource) || isMemberSafeProjectUpdate() || isSelfJoinUpdate();

      // delete: 생성자만
      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;

      // ─── 서브컬렉션: 멤버 전용 ──────────────────────────────────────────
      // 09.md 3.8 spec은 conversations/{stage}/messages 였으나
      // 실제 코드는 conversations/{activityCode}/messages 사용 (projects.ts:559–605)
      match /conversations/{activity}/messages/{msg} {
        allow read, write: if isMember(pid);
      }

      match /lobby/{msg} {
        allow read, write: if isMember(pid);
      }

      // 중요 노트(포스트잇) — 프로젝트 문서 배열에서 subcollection으로 이전.
      // 노트당 문서 1개(각 1MiB)라 길이/개수 사실상 무제한 + 부모 문서 1MiB 압박 해소.
      match /keyNotes/{nid} {
        allow read, write: if isMember(pid);
      }

      // 09.md 3.5 spec 경로 — 코드에서 saveArtifact/watchArtifact 정의는 있으나
      // 현재 호출 0건. 향후 활성화 대비.
      match /stages/{stage}/activities/{act}/artifacts/{aid} {
        allow read, write: if isMember(pid);
        match /versions/{vid} {
          allow read, write: if isMember(pid);
        }
      }

      // 09.md 3.9: 단계 전환 이력 — 생성만 허용, 수정/삭제 금지(이력 무결성)
      // initiatedBy 스푸핑 방지: 본인 uid만 기록 가능
      match /stage_transitions/{tid} {
        allow read: if isMember(pid);
        allow create: if isMember(pid)
          && request.resource.data.initiatedBy == request.auth.uid;
        allow update, delete: if false;
      }

      // 09.md 3.10: 주기 이력 — 멤버 전용
      match /cycle_history/{cid} {
        allow read, write: if isMember(pid);
      }

      // streamingState/{activityCode}/users/{uid} — 본인만 write, 멤버 read
      match /streamingState/{activity}/users/{uid} {
        allow read: if isMember(pid);
        allow write: if isMember(pid) && request.auth.uid == uid;
      }

      // RAG 자료 (spec 외 컬렉션, materials.ts)
      match /materials/{mid} {
        allow read, write: if isMember(pid);
      }
      match /materialChunks/{cid} {
        allow read, write: if isMember(pid);
      }

      // A-2-2 통합 수업목표 워크스페이스 presence — ephemeral cursor/포커스 상태
      // 부모 projects 문서를 건드리지 않도록 별도 서브컬렉션으로 분리 (트랜잭션 contention 회피)
      match /integratedGoalPresence/{uid} {
        allow read: if isMember(pid);
        allow create, update, delete: if isMember(pid) && request.auth.uid == uid;
      }

      // T-1-1 팀 비전 워크스페이스 presence — 같은 이유로 서브컬렉션 분리
      match /teamVisionPresence/{uid} {
        allow read: if isMember(pid);
        allow create, update, delete: if isMember(pid) && request.auth.uid == uid;
      }

      // T-2-1 역할 배분 워크스페이스 presence — 같은 패턴
      match /roleDistributionPresence/{uid} {
        allow read: if isMember(pid);
        allow create, update, delete: if isMember(pid) && request.auth.uid == uid;
      }

      // T-1-2 수업설계 방향 워크스페이스 presence — 같은 패턴
      match /lessonDesignDirectionPresence/{uid} {
        allow read: if isMember(pid);
        allow create, update, delete: if isMember(pid) && request.auth.uid == uid;
      }

      // ⚠️ 미래 확장 대응 — 이름이 "Presence"로 끝나는 모든 subcollection을 일괄 허용.
      // 새 워크스페이스 단계를 추가할 때마다 firestore.rules를 수정·재배포하지 않도록,
      // 컨벤션(`<scope>Presence`) 기반 정규식 매칭으로 한 번에 처리한다.
      // 위의 명시적 rule들과 OR 평가되므로 안전(명시 rule이 있으면 그게 먼저 통과).
      // 보안 동일: 멤버만 read, 본인만 write.
      match /{presenceCol}/{uid} {
        allow read: if isMember(pid) && presenceCol.matches('.*Presence');
        allow create, update, delete: if isMember(pid) && request.auth.uid == uid && presenceCol.matches('.*Presence');
      }

      // ⚠️ 협업 프롬프트 초안 (각 단계 모달의 "구체적으로 AI에게 요청하기" 입력)
      // 이름이 "PromptDraft"로 끝나는 subcollection 일괄 허용. presence와 동일 보안 모델:
      // 멤버 read, 본인만 write (각 팀원이 자기 행만 입력).
      match /{promptCol}/{uid} {
        allow read: if isMember(pid) && promptCol.matches('.*PromptDraft');
        allow create, update, delete: if isMember(pid) && request.auth.uid == uid && promptCol.matches('.*PromptDraft');
      }

      // catch-all: 그 외 서브컬렉션은 차단 (방어막)
      match /{document=**} {
        allow read, write: if false;
      }
    }

    // ─── public_reports ───────────────────────────────────────────────────
    // 공개 배포된 보고서 스냅샷. 원본 projects/{pid}와 분리하여 민감 데이터 차단.
    // read: 공개 (로그인 불필요) — "공개 링크" 기능의 핵심.
    // write: 해당 프로젝트의 호스트(hostUid) 또는 createdBy만.
    //
    // 보안 전제:
    //  - 이 컬렉션 문서는 앱이 민감 필드(memberUids/memberInfo/messages/inviteCode/
    //    hostUid/createdBy 등)를 제외하고 추린 스냅샷만 담는다. publicReports.ts의
    //    buildPublicReport() 참조.
    //  - 즉 규칙 레벨에서 필드 검사까진 하지 않고, 앱 레벨에서 복사 경로를 강제한다.
    match /public_reports/{pid} {
      allow read: if true;
      allow create, update, delete: if isSignedIn()
        && (
          get(/databases/$(database)/documents/projects/$(pid)).data.hostUid == request.auth.uid
          || get(/databases/$(database)/documents/projects/$(pid)).data.createdBy == request.auth.uid
        );
    }

    // ─── 사용자 설정 (대시보드 폴더 등) ──────────────────────────────────
    match /user_settings/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // ─── 그 외 모든 경로 차단 ────────────────────────────────────────────
    // 09.md spec의 standards_index/standards_by_grade 는 현재 미적재 상태.
    // 향후 적재 시 해당 컬렉션에 read-only rule을 명시적으로 추가할 것.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
