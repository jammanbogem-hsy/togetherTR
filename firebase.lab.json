{
  "hosting": {
    "predeploy": [
      "node scripts/clean-next-artifacts.mjs"
    ],
    "site": "togethertr-curriculum-map",
    "source": ".",
    "ignore": [
      "firebase.json",
      "firebase.lab.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "/dev/curriculum-map",
        "type": 302
      }
    ],
    "frameworksBackend": {
      "region": "asia-northeast3",
      "memory": "512MiB"
    }
  }
}
