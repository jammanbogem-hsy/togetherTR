rules_version = '2';

// ─── togethertr / T-CID Storage Security Rules ─────────────────────────────
// 경로: projects/{projectId}/materials/{materialId}/{fileName}
// 멤버십: Firestore projects/{pid}.memberUids 배열에 request.auth.uid 포함 여부로 판정
// ───────────────────────────────────────────────────────────────────────────

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isProjectMember(pid) {
      return isSignedIn()
        && firestore.get(/databases/(default)/documents/projects/$(pid))
             .data.memberUids.hasAny([request.auth.uid]);
    }

    // 프로젝트 자료함: PDF 업로드/읽기
    match /projects/{projectId}/materials/{materialId}/{fileName=**} {
      allow read: if isProjectMember(projectId);
      allow write: if isProjectMember(projectId)
                   && request.resource.size < 200 * 1024 * 1024
                   && request.resource.contentType.matches('application/pdf');
      allow delete: if isProjectMember(projectId);
    }

    // 최고관리자(개발자) 관찰 — 읽기 전용
    function isSuperAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'jammanbogem@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // 채팅 첨부(사진·PDF·텍스트): 팀원은 자기 폴더에만 올리고, 팀원 모두 읽는다
    match /projects/{projectId}/chat/{uid}/{attachmentId}/{fileName} {
      allow read: if isProjectMember(projectId) || isSuperAdmin();
      allow create: if isProjectMember(projectId)
                    && request.auth.uid == uid
                    && request.resource.size < 20 * 1024 * 1024
                    && request.resource.contentType.matches('image/(png|jpeg|webp|gif)|application/pdf|text/(plain|markdown|csv)');
      allow update: if false;
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // 그 외 모든 경로는 기본 거부
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
